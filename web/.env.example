# Copy to web/.env.local and fill in your own values. Never commit .env.local.

# MongoDB Atlas connection string (your own cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to room_mood
MONGODB_DB=room_mood

# Anthropic API key for Claude Haiku sentiment. Blank is fine: moods still save with sentiment: null.
ANTHROPIC_API_KEY=

# Optional: public URL used for the join QR code (e.g. https://your-app.example.com)
PUBLIC_ORIGIN=
